Tile drawText(Tile& blankTile, std::vector<std::vector<int>> instr, Pixel textColor)
{
	if(instr.size() < 9) // a tile is 8x8 pixels. 8*8 = 64.
	{
		for(int i = 0; i < instr.size(); i++)
		{
			for(int j = 0; j < instr[i].size(); j++)
			{
				if(instr[i][j] == 1)
				{
					blankTile.setPixel(Pos(j,i), textColor);
				}
			}
		}
	}
	return blankTile;
}

