struct Distances
{
	int Xdiff;
	int Ydiff;
	double EuclideanDistance;
};

class Pos
{

public:

	//Represents a single X,Y Position.
	Pos(int x, int y)
	{
		m_x = x;
		m_y = y;
	}


	/*
	Gives the distance between two Pos objects.
	consisting of an X distance, a Y distance and a euclidean distance with pythagoras theorem
	*/
	Distances operator-(const Pos& other) const
	{
		int deltaX = m_x - other.m_x;
		int deltaY = m_y - other.m_y;
		return Distances{deltaX, deltaY, sqrt((deltaX*deltaX)+(deltaY*deltaY))};
	}

	// Look, I Just think these utility functions were useful. They came from AI. I thought
	// Why not just use these, they're there, and save me a little effort.

	Pos operator+(const Pos& other) const {
		return Pos(m_x + other.m_x, m_y + other.m_y);
	}

    bool operator<(const Pos& other) const {
        if(m_y != other.m_y)
        {
        return m_y < other.m_y;
        }
        return m_x < other.m_x;
    }
    bool operator==(const Pos& other) const {
        return (m_x == other.m_x) && (m_y == other.m_y);
    }
//	auto operator <=>(const Pos&) const noexcept = default;
	friend std::ostream& operator<<(std::ostream& os, const Pos& p) {
		os << "( X = " << p.m_x << ", Y = " << p.m_y << ")";
		return os;
	}
	//unit conversions
	static float pixelsToTiles(float pixels)
	{
		return pixels/8;
	}

	static float tilesToPixels(float tiles)
	{
		return tiles * 8;
	}
	int m_x;
	int m_y;

};
struct color {
	float Red;
	float Blue;
	float Green;
	float transparency;

};

class Pixel: public Pos
{
public:
    bool _isTransparent;
	/* Pixel
	inputs: index (int), alpha (int), scrPos(Pos)
	outputs: none depends on: Pos (Class) 
	Depends on: none
	Creates a colour on a screen. To handle transparency, Call the TrueAlpha function
	 BG == background
	*/
	Pixel(int red,int green,int blue, Pos scrpos = Pos(0,0)):Pos(scrpos.m_x,scrpos.m_y)
	{
		// the mathematecally correct way to translate 5 bit to 8 bit colour
		int r = int((red % 32) * (255.0/31.0));
	    int b = int((blue % 32) * (255.0/31.0));
		int g = int((green % 32) * (255.0/31.0));

		_isTransparent = false;
		m_BackGroundRed = r;
		m_BackGroundGreen = g;
		m_BackGroundBlue = b;

	}
	/* returns an instance of a Pixel as a String ready to print. */
	std::string prepSelf()
	{
		std::string output;

	
			output = std::format("\x1b[0;38;2;0;0;0;48;2;{};{};{}m \x1b[0m", m_BackGroundRed, m_BackGroundGreen, m_BackGroundBlue);
		return output;

	}
	int getRed()
	{
		return m_BackGroundRed;

	}
	int getGreen()
	{
		return m_BackGroundGreen;
	}
	int getBlue()
	{
		return m_BackGroundBlue;
	}

	void setNewRGB(int BGRed, int BGGreen, int BGBlue)
	{
		m_BackGroundRed = (BGRed % 32) * (255.0/31.0);
		m_BackGroundBlue = (BGBlue % 32) * (255.0/31.0);
		m_BackGroundGreen = (BGGreen % 32) * (255.0/31.0);

	}
	// inputs: other (Pixel), alpha (float)
	// outputs: index (int)
	// depends on: none
	//Performs proper alpha blending.
	// the functiuon is based on this formula:
	// result = (tranparency * foreground) + (1 - transparency) * background
	//0.0 color A| -----------------------------------| 1.0 colour B
	color trueAlpha(Pixel other, float alpha)
	{
		if(alpha < 0.0 || alpha > 1.0)
		{	//error
			alpha = 0.5;
		}
		// background
		float foregroundAR;
		float foregroundAG;
		float foregroundAB;
		float backgroundAR;
		float backgroundAG;
		float backgroundAB;
	
		
	    foregroundAR = alpha *m_BackGroundRed;
		foregroundAG = alpha *m_BackGroundGreen;
		foregroundAB = alpha *m_BackGroundBlue;
		backgroundAR = (1-alpha) * other.getRed();
		backgroundAG = (1-alpha) * other.getGreen();
		backgroundAB = (1-alpha) * other.getBlue();
		
	
		float finalAR = foregroundAR+backgroundAR;
		float finalAG = foregroundAG+backgroundAG;
		float finalAB = foregroundAB+backgroundAB;
		
		color result;
		result.transparency = alpha;
		result.Red = finalAR;
		result.Green = finalAG;
		result.Blue = finalAB;
		return result;

	}
private:

	int m_BackGroundRed;
	int m_BackGroundGreen;
	int m_BackGroundBlue;



};
