// a collection of tiles which can move.
//make sure that any tiles of a sprite are initialised as sprite tiles.
class Sprite
{

public:
	Sprite(): _Gpos(0,0)
	{
		_tileMap = {};

	}

	virtual void addTile(Tile& tile, int rowIndex)
	{
		if(rowIndex >= _tileMap.size())
		{
			_tileMap.resize(rowIndex + 1);
		}
		_tileMap[rowIndex].push_back(tile);
	}

	virtual void editTile(int indX, int indY, Pos pos, Pixel newData)
	{
		if(indY >= 0 && indY < _tileMap.size())
		{
			if(indX>= 0 && indX < _tileMap[indY].size())
			{
				_tileMap[indY][indX].setPixel(pos, newData);
			}
		} else {
			std::cout<<"Sprite::editTile() recieved invalid indexes"<< std::to_string(indX) << std::to_string(indY) <<std::endl;
			return;
		}
	}

	virtual Tile& getTile(int indX, int indY)
	{
	    static Tile defaultReturn = Tile(Pos(-1,-1),true,false);
		if(indY >= 0 && indY < _tileMap.size())
		{
			if(indX >= 0 && indX < _tileMap[indY].size())
			{
				return _tileMap[indY][indX];
			}
		}
	    	std::cout<<"Sprite::getTile() recieved invalid indexes"<< std::to_string(indX) << std::to_string(indY) <<std::endl;
			return defaultReturn;

	}

	virtual void replaceTile(int indX, int indY, Tile newTile)
	{
		if(indY >= 0 && indY < _tileMap.size())
		{
			if(indX>=0 && indX < _tileMap[indY].size())
			{
				_tileMap[indY][indX] = newTile;
			}
		} else {
			std::cout<<"Sprite::replaceTile() recieved invalid indexes"<< std::to_string(indX) << std::to_string(indY) <<std::endl;
			return;
		}
	}


	// A way to make sprites move.
	void updateGlobalPos(Pos Gpos)
	{
		_Gpos = Gpos;
		for(int y = 0; y < _tileMap.size(); y++)
		{
			for(int x = 0; x < _tileMap[y].size(); x++)
			{
				//This line takes into account offsets, so it can keep a sprite
				// from falling into it's constituent tiles.
				_tileMap[y][x].setNewGlobalPos(Pos(Gpos.m_x+Pos::tilesToPixels(x),Gpos.m_y+Pos::tilesToPixels(y)));
			}
		}
	}

	std::vector<std::vector<Tile>> getTileMap()
	{
		return _tileMap;
	}
	/*
	input: none
	output: output (map<Pos,vector<string>)
	depends on: Tile::getGlobalPos(), Tile::prepTile(), map::at(), vector::size()
	Returns a bunch of prepared Tiles. FOR DEBUGGING PURPOSES ONLY
	*/
	std::map<Pos,std::vector<std::string>> prepSprite()
	{
		std::map<Pos,std::vector<std::string>> output;
		for(int y = 0; y< _tileMap.size(); y++)
		{
			for(int x = 0; x<_tileMap[y].size(); x++)
			{
				output[_tileMap[y][x].getGlobalPos()]=_tileMap[y][x].prepTile();
			}
		}
		return output;
	}
	/*
	input: graphic (map<Pos,vector<string>>)
	output: bool
	depends on: auto, map::first, Pos, vector::push_back, map::at, iostream
	This function actually draws a Sprite. FOR DEBUGGING PURPOSES ONLY
	*/
	void drawSprite(std::map<Pos,std::vector<std::string>> graphic)
	{
	    /*
	    --SECTION 0--
	    This goes through the given graphic, and finds each unique position, to generate
	    a 2D vector, representing each unique position the Sprite covers. This then feeds
	    into SECTION 1, which will then use that data to go row by row. 
	    */
	    std::vector<std::vector<Pos>> rowGroupings;
	    std::vector<Pos> row;
	    int currentRowNum = 0;
	    //bool changeRowNum = false;
	    for(auto STile: graphic)
	    {
	       
	       
	  
	      if(STile.first.m_y == currentRowNum) 
	      {
	 
	          row.push_back(STile.first);
	      }
	      else
	      {
	    
	        rowGroupings.push_back(row);
	        row = {};
	        currentRowNum = STile.first.m_y;
	        row.push_back(STile.first);

	      }
	    }
	    if(!row.empty())
	    {
	        rowGroupings.push_back(row);
	    }
	    /*
	    --SECTION 1--
	    This takes the data generated in SECTION 0, and uses that to hopefully correctly draw a sprite
	    */
	    std::string output;
	    for(int y = 0; y < rowGroupings.size(); y++)
	    {
	        
	       for(int i = 0; i < 8; i++)
	       {
	       output = "";
	        for(int x = 0; x < rowGroupings[y].size(); x++)
	        {
	           output+=graphic.at(rowGroupings[y][x])[i];
	        }
	        std::cout<<output<<'\n';

	       }
	    }
	}
	Pos getGlobalPos()
	{
		return _Gpos;
	}

protected:
	std::vector<std::vector<Tile>> _tileMap;
	Pos _Gpos;
};
//ah, yes. a screen.
class Screen
{
public:
//remeber: originl res: 32W, 28H
	static const int tilesW = 50;
	static const int tilesH = 30;
	static const int tileSize = 8;
	Screen()
	{
		std::vector<Tile> row = {};
		for(int y = 0; y < tilesH; y++)
		{
			row = {};
			for( int x = 0; x < tilesW; x++)
			{
				row.push_back(Tile(Pos(x*tileSize, y*tileSize),false,false));
			}
			_tiles.push_back(row);
		}
		_PX = 0;
		_PY = 0;
		_TX = 0;
		_TY = 0;
		_allowScrolling = false;
	}

	void setTile(Pos tilePos, Tile& newTile)
	{
		int x;
		int y;
		if(!_allowScrolling)
		{
			x = tilePos.m_x % tilesW;
			y = tilePos.m_y % tilesH;
		} else {
			y = tilePos.m_y % _tiles.size();
			x = tilePos.m_x % _tiles[y].size();
		}
		_tiles[y][x] = newTile;
	}

	Tile& getTile(Pos posInTiles)
	{
		int x;
		int y;
		if(!_allowScrolling)
		{
			x = (posInTiles.m_x % tilesW);
			y = (posInTiles.m_y % tilesH);
		} else {
			y = (posInTiles.m_y % _tiles.size());
			x = (posInTiles.m_x % _tiles[y].size());
		}
		return _tiles[y][x];
	}
	void setNewScrollOffset(Pos pixelOffset, Pos tileOffset)
	{
		int PX = pixelOffset.m_x;
		int PY = pixelOffset.m_y;
		int TX = tileOffset.m_x;
		int TY = tileOffset.m_y;
		//PX and PY must stay in the bounds of a tile
		_PX += PX;
		_PY += PY;
		_TX += floor(PX/8);
		_TY += floor(PY/8);
		_PX = ((PX %8)+ 8)% 8;
		_PY = ((PY %8)+ 8)% 8;
		_allowScrolling = true;
	}
	/*
	This prepares one row of Pixels to be drawn.
	*/
	std::string prepRow(int TrowG, int TrowL)
	{
		std::string output = "";
		for(int i = 0; i < tilesW; i++)
		{
			Tile& currentTile = _tiles[TrowG+_TY][i+_TX];
			std::vector<std::vector<Pixel>> CTData = currentTile.getTileData();
			for(int j = 0; j < 8; j++)
			{
				output += CTData[TrowL+_PY][j+_PX].prepSelf();
			}
		}
		return output;
	}
	/*
	This takes the given sprite, and uses it's global position to correctly
	composite it, so that it can be viewed.
	*/
	void compositeSprite(Sprite& sprite)
	{
		const std::vector<std::vector<Tile>>& STileMap = sprite.getTileMap();
		float PNG = 1.0;
		for(int y = 0; y <STileMap.size(); y++)
		{
			for(int x = 0; x < STileMap[y].size(); x++)
			{
				Tile currentSpriteTile = STileMap[y][x];
				Tile currentBGTile = *Tile::TileRef.at(currentSpriteTile.getGlobalPos());
				_compositedTiles.push_back(currentBGTile);
				for(int PY = 0; PY < 8; PY++)
				{
					for(int PX = 0; PX < 8; PX++)
					{
					    Pixel currentSpritePixel = currentSpriteTile.getPixel(Pos(PY,PX));
					    if(currentSpritePixel._isTransparent)
					    {
					        PNG = 0.0; 
					    }
					    else
					    {
					        PNG = 1.0;    
					    }
						color compositedColor = currentBGTile.getPixel(Pos(PY,PX)).trueAlpha(currentSpriteTile.getPixel(Pos(PY,PX)),PNG);
						Pixel compositedPixel = Pixel(compositedColor.Red,compositedColor.Blue,compositedColor.Green,(currentBGTile.getGlobalPos()));
						currentBGTile.setPixel(Pos(PY,PX),compositedPixel);
					}
				}
				setTile(currentBGTile.getGlobalPos(),currentBGTile);// actually applies the compositing
			}
		}
	}
	/*
	This resets the compositing process of compositeSprite.
	RECCOMENDED ORDER OF OPERATIONS:
	0) Game logic <- you can customise this.
	(Please use setNewScrollOffset before your game logic exits if you need to)
	1) compositeSprite()
	2) drawScreen()
	3) resetCompositing()
	*/
	void resetCompositing()
	{
		for(int i = 0; i < _compositedTiles.size(); i++)
		{
			Tile::TileRef[_compositedTiles[i].getGlobalPos()] = make_shared<Tile>(_compositedTiles[i]);
		}
		_compositedTiles = {};
	}
	void drawScreen()
	{
		for(int i = 0; i < tilesH; i++)
		{
			for(int j = 0; j < tileSize; j++)
			{
				std::cout << prepRow(i,j) <<std::endl;
			}
		}
	}

private:
	std::vector<std::vector<Tile>> _tiles;
	std::vector<Tile> _compositedTiles;
	int _PX;
	int _PY;
	int _TX;
	int _TY;
	bool _allowScrolling;

};


// this gives a sprite with ANIMATION!
class IndexedSprite: public Sprite
{
public:
	IndexedSprite():Sprite()
	{
		_currentFrame = {};
	}
	std::vector<Pos> getCurrentFrame()
	{
		return _currentFrame;
	}

	void setCurrentFrame(std::vector<Pos> newFrame)
	{
		_currentFrame = newFrame;
	}

	void  addTile(Tile& tile, int rowIndex) override
	{
		if(rowIndex >= _allFrames.size())
		{
			_allFrames.resize(rowIndex + 1);
		}
		_allFrames[rowIndex].push_back(tile);
	}

	void editTile(int indX, int indY, Pos pos, Pixel newData) override
	{
		if(indY >= 0 && indY < _allFrames.size())
		{
			if(indX>=0 && indX < _allFrames[indY].size())
			{
				_allFrames[indY][indX].setPixel(pos, newData);
			}
		}
	}

	void replaceTile(int indX, int indY, Tile newTile) override
	{
		if(indY >= 0 && indY < _allFrames.size())
		{
			if(indX>=0 && indX < _allFrames[indY].size())
			{
				_allFrames[indY][indX] = newTile;
			}
		}
		else
		{
		    std::cout<<"IndexedSprite::replaceTile() recieved invalid indexes"<< std::to_string(indX) << std::to_string(indY) <<std::endl;
			return;
		}
	}

	Tile&  getTile(int indX, int indY) override
	{
	    static Tile defaultReturn = Tile(Pos(-1,-1),true,false);
		if(indY >= 0 && indY < _allFrames.size())
		{
			if(indX >= 0 && indX < _allFrames[indY].size())
			{
				return _allFrames[indY][indX];
			}
		} else
		{
			std::cout<<"IndexedSprite::getTile() recieved invalid indexes"<< std::to_string(indX) << std::to_string(indY) <<std::endl;
			return defaultReturn;
		}
	}
	// this allows you to change frames
	void setupFrame()
	{
		for(int i = 0; i < _currentFrame.size(); i++)
		{
			if(_currentFrame[i].m_y >= _allFrames.size() || _currentFrame[i].m_x >= _allFrames[_currentFrame[i].m_y].size())
			{
				std::cout<<"IndexedSprite::setupFrame() experienced an error"<<std::endl;
			    return;
			}
			Sprite::replaceTile(
			    _currentFrame[i].m_x,
			    _currentFrame[i].m_y,
			    _allFrames[_currentFrame[i].m_y][_currentFrame[i].m_x]
			);
		}

	}

protected:
	/*

	_currentFrame
	Contains a bunch of Pos Objects.These Pos objects are used as 2D indices into
	the _tileMap inherited from Sprite. This is so that the current values in th
	_currentFrame represents the CURRENT index of an IndexedSprite. Beware that,
	in indexedSprite, a Pos object is in TILES. To alleviate this, call tilesToPixels
	*/
	std::vector<Pos> _currentFrame;
	std::vector<std::vector<Tile>> _allFrames;
};

//finally, an entity.
class Entity: public IndexedSprite
{
public:

	Entity(int HP)
	{
		_hitPoints = HP;
	}

	void setHP(int newHP)
	{
		if(newHP >= 0)
		{
			_hitPoints = newHP;
		}
	}
	int getHP()
	{
		return _hitPoints;
	}

	void setCollision(bool newState)
	{
		_hasCollision = newState;
	}
	/*
	The more advanced, but slow way to check collision, Best used for interactions between Entity objects.
	because this method does not rely on the Tile Registry.
	*/
	bool collisionCheck(Tile other)
	{
		Pos tilePos = other.getGlobalPos(); 
		std::vector<Distances> tileDists; // contains a list of all the Distances stuct instances 
		for(int y = 0; y < _tileMap.size(); y++)
		{
			for(int x = 0; x < _tileMap[y].size(); x++)
			{
				tileDists.push_back(tilePos-_tileMap[y][x].getGlobalPos()); // calculates a Distances struct
			}
		}
		std::vector<double> euclids;
		for(int i = 0; i < tileDists.size(); i++)//extracts the euclidean distance
		{
			euclids.push_back(tileDists[i].EuclideanDistance);
		}
		/*
		This check will extract the shortest euclidean distance from the list of euclidean distances calculated earlier.
		Should there be a distance of less than 1, that signals a collision.
	    Because Pos objects are an integer coordinates, and Pixels inherit from Pos, This calculates distances in Pixels.
	    Thus, a euclidean distance of less than 1 indicates that the two objects are less than 1 pixel apart, and are thus colliding
		*/
		if(!euclids.empty() && *min_element(euclids.begin(),euclids.end())< 1)
		{
			return true;
		}
		return false;
	}

	void addAnimation(std::vector<std::vector<Pos>>& AF)
	{
		_animFrames.push_back(AF);
	}

	void editAnimation(int index, std::vector<std::vector<Pos>> stuff)
	{
		if(index > -1 && index < _animFrames.size())
		{
			_animFrames[index] = stuff;
		}
	}

	void setCurrentAnimIndex(int newInd)
	{
		_currentAnimIndex = newInd;
	}

	void advanceOneFrame()
	{

		
		_frame = ((++_frame) % _animFrames[_currentAnimIndex].size()); //+ startOffset;
	}

	void applyFrame()
	{
		_currentFrame = _animFrames[_currentAnimIndex][_frame];
	}
	/*
	A simper, faster method of checking collision.
	inputs: gravVector (Pos), tileIndex(std::map<Pos,Tile>)
	outputs: Pos.
	depends on: std::map
	*/
	Pos calculatePhysics(Pos gravVector, std::map<Pos,Tile> tileIndex)
	{
		Pos newGPos = _Gpos + gravVector;
		if(tileIndex.count(newGPos) != 0)
		{
			if(tileIndex.at(newGPos)._collidable)
			{
				return _Gpos;
			}
		}
		return newGPos;
	}
private:

	int _hitPoints;
	bool _hasCollision=true;
	std::vector<std::vector<std::vector<Pos>>> _animFrames;
	int _currentAnimIndex;
	int _frame;


};
