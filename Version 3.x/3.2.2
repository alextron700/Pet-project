class UniversalColorPallette
{
public:
	UniversalColorPallette(std::map<int, Pixel> UCPR)
	{
		_UCPRegistry = UCPR;
		nextOpenID = 0;
		if (!_UCPRegistry.empty()) {
			auto last_element = _UCPRegistry.rbegin();
			int max_existing_id = last_element->first;
			nextOpenID = max_existing_id + 1;
		}

		// Ensure we never allocate below 8, even if the highest existing ID was, say, 7.
		if (nextOpenID < 0) {
			nextOpenID = 0;
		}
		for (auto c: UCPR)
		{
			_usageTracker[c.first] = 0;
			//nextOpenID +=1;
		}
	}
	registrySearch useLookup(int index)
	{
		registrySearch output;
		if (_UCPRegistry.count(index) != 0 && _usageTracker.count(index) != 0)
		{
			output.result = _UCPRegistry.at(index);
			output.error = false;
			_usageTracker[index]++;
		}
		return output;
	}
	int addToRegistry(Pixel newEntry)
	{
		const int maxSize = 4000;
		bool willEvict = false;
		int id = 0;
		if (_UCPRegistry.size() >= maxSize || _usageTracker.size() >= maxSize || nextOpenID >= maxSize)
		{
			willEvict = true;
		}
		if (willEvict)
		{
			auto it = std::min_element(
				_usageTracker.begin(),
				_usageTracker.end(),
				[](const auto& a, const auto& b)
				{
					return a.second < b.second;

				});
			//    if(it->first != 0)
			 //   {
			id = it->first;
			_usageTracker.at(id) = 0;
			_UCPRegistry.erase(id);
			_UCPRegistry[id] = newEntry;
			//    }else
			//   {
			//        throw std::range_error("Invoked UCP::addToRegistry: Attempted to delete invalid key!");
			// }
		}
		else
		{
			id = nextOpenID++;
			_UCPRegistry[id] = newEntry;
			_usageTracker[id] = 0;
		}

		return id;

	}
	std::map<int, Pixel> getRegistry(bool renderTime = true)
	{
		if (renderTime)
		{
			std::map<int, Pixel> _UCPRCopy;
			for (auto ID : _UCPRegistry)
			{
				_UCPRCopy[ID.first + 8] = ID.second;
			}
			return _UCPRCopy;
		}
		return _UCPRegistry;
	}


	int searchByRGB(Pixel& p)
	{
		for (auto& ID : _UCPRegistry)
		{
			if (ID.second.getRed() == p.getRed())
			{
				if (ID.second.getGreen() == p.getGreen())
				{
					if (ID.second.getBlue() == p.getBlue())
					{
						return ID.first;

					}
				}
			}
		}
		return addToRegistry(p);
	}
private:
	std::map<int, Pixel> _UCPRegistry;
	std::unordered_map<int, int> _usageTracker;
	int nextOpenID;
};
/*
an indexable 8x8 collection of Pixels 
*/
class Tile
{

public:
	//	static std::map<Pos,std::unique_ptr<Tile>> TileRef;
	bool _collidable;
	// creates a tile. The supplied coordinates specify the GLOBAL scope coordinates (where in the world a Tile goes)
	// Tiles are 8x8, if isSprite is true, a Tile is allowed to move, else it is put on the Tile registry, and not allowed to move
	// (except scrolling)
	Tile(Pos Gpos, bool isSprite, bool collidable = false)
	{
		_globalScopeX = Gpos.m_x;
		_globalScopeY = Gpos.m_y;
		_tileData = {};
		std::vector<Pixel> row = {};
		for (int y = 0; y < 8; y++)
		{
			for (int x = 0; x < 8; x++)
			{
				row.push_back(Pixel(0, 0, 0, Pos(x + _globalScopeX, y + _globalScopeY)));
			}
			_tileData.push_back(row);
			row = {};
		}
		_collidable = collidable;
		_isSprite = isSprite;

	}

	/*
	Tiles - An Explanation:
	A Tile has two sets of coordinates. You will find throughout this codebase:
	LPos and GPos.
	GPos - A Tile's position, globally. This defines where in the world a Tile is.
	LPos - A position IN a tile, Local pos. since a Tile is 8x8 pixels, an LPos is
	useful to define which pixel in a tile is being specified.
	Generally, any Global-scope coordinate (world-space) will have a G in it's name,
	and any Local-scope coordinate (within a Tile) will have an L in it's name.
	Tiles are divided into two groups:
	Standard Tiles
	and Sprite Tiles.
	*/

	/*
	Standard Tiles are constructed as such:
	Tile(Pos, false, collidable)

	Standard Tiles are barred from moving, and are put into a registry, called TileRef.
	TileRef allows you to search standard Tiles by their global position, using
	TileRef.at(Pos); or TileRef[Pos];

	Sprite Tiles are constructed as such:
	Tile(Pos, true, collidable)

	Sprite Tiles are allowed to move, but cannot (and should not) be searched by
	Global Position with the TileRef as you would a Standard Tile, as Sprite Tiles can move,
	which risks a keyspace collision, as such, to prevent that, Sprite Tiles are barred from
	TileRef
	*/
	// this sets a pixel in a tile, making sure indexing out of bounds isn't possible
	void setPixel(Pos Lpos, Pixel newData)
	{
		int localScopeX = Lpos.m_x % 8; // making sure indexes out of bounds are impossible
		int localScopeY = Lpos.m_y % 8;
		_tileData[localScopeY][localScopeX].setNewRGB(newData.getRed(), newData.getGreen(), newData.getBlue());

	}
	//retrieves a pixel from a tile, making sure index out of bounds isn't posssible
	Pixel getPixel(Pos Lpos)
	{
		int localX = Lpos.m_x % 8;
		int localY = Lpos.m_y % 8;
		return _tileData[localY][localX];
	}

	// transforms a tile into a bunch of printable pixels. In essence, calling prepSelf on 64 pixels.
	// Only use for debugging!

	std::vector<std::string> prepTile()
	{
		std::vector<std::string> output;
		std::string tileRow = "";
		for (int y = 0; y < 8; y++)
		{
			for (int x = 0; x < 8; x++)
			{
				tileRow += _tileData[y][x].prepSelf();
			}
			output.push_back(tileRow);
			tileRow = "";
		}
		return output;
	}
	bool getIsSprite()
	{
		return _isSprite;
	}
	/*
	inputs: none
	outputs: none
	depends on: prepTile
	Draws a tile directly to the console. Please only use for debugging.
	*/

	void drawTile()
	{
		std::vector<std::string> data = prepTile();
		for (int i = 0; i < 8; i++)
		{
			std::cout << data[i] << std::endl;
		}
	}
	void setNewGlobalPos(Pos Gpos)
	{
		if (_isSprite)
		{
			_globalScopeX = Gpos.m_x;
			_globalScopeY = Gpos.m_y;
			for (int y = 0; y < 8; y++)
			{
				for (int x = 0; x < 8; x++)
				{
					Pixel& current = _tileData[y][x];
					current.m_x = _globalScopeX + x;
					current.m_y = _globalScopeY + y;
				}
			}
		}
	}

	std::vector<std::vector<Pixel>>& getTileData()
	{
		return _tileData;
	}

	Pos getGlobalPos()
	{
		return Pos(_globalScopeX, _globalScopeY);
	}
private:
	std::vector<std::vector<Pixel>> _tileData;
	int _globalScopeX;
	int _globalScopeY;
	bool _isSprite;



};

