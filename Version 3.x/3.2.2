//an 8-bit per channel color with position. 
class Pixel : public Pos
{
public:
	bool _isTransparent;
	/* Pixel
	inputs: red(int),green(int),blue (int) scrPos(Pos)
	outputs: none
	Depends on: Pos()
	Creates a colour on a screen. To handle transparency, Call the TrueAlpha function
	 BG == background
	*/
	Pixel() :Pos(69, -420)
	{
		if (!error)
		{
			m_BackGroundRed = 255;
			m_BackGroundGreen = 0;
			m_BackGroundBlue = 255;
			error = true;
		}
		else
		{
			m_BackGroundRed = 0;
			m_BackGroundGreen = 0;
			m_BackGroundBlue = 0;
			error = false;
		}
	}
	Pixel(int red, int green, int blue, Pos scrpos = Pos(0, 0)) :Pos(scrpos.m_x, scrpos.m_y)
	{


		_isTransparent = false;
		m_BackGroundRed = red;
		m_BackGroundGreen = green;
		m_BackGroundBlue = blue;

	}

	//the standard prepSelf algorithm
	std::string prepSelf() const
	{
		// WARNING: This is now slower string creation, but necessary for compatibility.
		return std::format("\033[48;2;{};{};{}m \033[m", m_BackGroundRed, m_BackGroundGreen, m_BackGroundBlue);
	}
	/* returns an instance of a Pixel as a String ready to print. FprepSelf is the Fast prepSelf, shortened to FprepSelf */
	template<class retVal>
	retVal FprepSelf(retVal it, Pos pos)
	{
		Pos P = pos;
		constexpr std::string_view formatStr = "\x1b[{};{}H\x1b[0;48;2;{};{};{}m ";
		return std::format_to(it, formatStr, pos.m_y + 1, pos.m_x + 1, m_BackGroundRed, m_BackGroundGreen, m_BackGroundBlue);
	}

	int getRed()
	{
		return m_BackGroundRed;

	}
	int getGreen()
	{
		return m_BackGroundGreen;
	}
	int getBlue()
	{
		return m_BackGroundBlue;
	}

	void setNewRGB(int BGRed, int BGGreen, int BGBlue)
	{
		//		m_BackGroundRed = (BGRed % 32) * (255.0/31.0);
		//		m_BackGroundBlue = (BGBlue % 32) * (255.0/31.0);
		//		m_BackGroundGreen = (BGGreen % 32) * (255.0/31.0);
		m_BackGroundRed = BGRed;
		m_BackGroundBlue = BGBlue;
		m_BackGroundGreen = BGGreen;


	}

	// inputs: other (Pixel), alpha (float)
	// outputs: color (struct)
	// depends on: none
	//Performs proper alpha blending.
	// the functiuon is based on this formula:
	// result = (tranparency * foreground) + (1 - transparency) * background
	//0.0 color A| -----------------------------------| 1.0 colour B
	color trueAlpha(Pixel other, float alpha)
	{
		if (alpha < 0.0 || alpha > 1.0)
		{	//error
			alpha = 0.5;
		}
		// background
		float foregroundAR;
		float foregroundAG;
		float foregroundAB;
		float backgroundAR;
		float backgroundAG;
		float backgroundAB;


		foregroundAR = alpha * m_BackGroundRed;
		foregroundAG = alpha * m_BackGroundGreen;
		foregroundAB = alpha * m_BackGroundBlue;
		backgroundAR = (1 - alpha) * other.getRed();
		backgroundAG = (1 - alpha) * other.getGreen();
		backgroundAB = (1 - alpha) * other.getBlue();


		float finalAR = foregroundAR + backgroundAR;
		float finalAG = foregroundAG + backgroundAG;
		float finalAB = foregroundAB + backgroundAB;

		color result;
		result.transparency = alpha;
		result.Red = finalAR;
		result.Green = finalAG;
		result.Blue = finalAB;
		return result;

	}
private:

	int m_BackGroundRed;
	int m_BackGroundGreen;
	int m_BackGroundBlue;
	static bool error;



};
