// a collection of tiles which can move.
//make sure that any tiles of a sprite are initialised as sprite tiles.
class Sprite
{

public:
	Sprite() : _Gpos(0, 0)
	{
		_tileMap = {};

	}

	virtual void addTile(Tile& tile, int rowIndex)
	{
		if (rowIndex >= _tileMap.size())
		{
			_tileMap.resize(rowIndex + 1);
		}
		if (tile.getIsSprite())
		{
			_tileMap[rowIndex].push_back(tile);
		}
		else {
			std::cout << "Hey! Sprite should only have Tiles initialised as Sprite Tiles! Initialised with Tile(Pos,true,collidable);" << std::endl;
			return;
		}
	}

	virtual void editTile(int indX, int indY, Pos pos, Pixel newData)
	{
		if (indY >= 0 && indY < _tileMap.size())
		{
			if (indX >= 0 && indX < _tileMap[indY].size())
			{
				_tileMap[indY][indX].setPixel(pos, newData);
			}
		}
		else {
			std::cout << "Sprite::editTile() recieved invalid indexes" << std::to_string(indX) << std::to_string(indY) << std::endl;
			return;
		}
	}

	virtual Tile& getTile(int indX, int indY)
	{
		static Tile defaultReturn = Tile(Pos(-1, -1), true, false);
		if (indY >= 0 && indY < _tileMap.size())
		{
			if (indX >= 0 && indX < _tileMap[indY].size())
			{
				return _tileMap[indY][indX];
			}
		}
		std::cout << "Sprite::getTile() recieved invalid indexes" << std::to_string(indX) << std::to_string(indY) << std::endl;
		return defaultReturn;

	}

	virtual void replaceTile(int indX, int indY, Tile newTile)
	{
		if (indY >= 0 && indY < _tileMap.size())
		{
			if (indX >= 0 && indX < _tileMap[indY].size())
			{
				_tileMap[indY][indX] = newTile;
			}
		}
		else {
			std::cout << "Sprite::replaceTile() recieved invalid indexes" << std::to_string(indX) << std::to_string(indY) << std::endl;
			return;
		}
	}


	// A way to make sprites move.
	void updateGlobalPos(Pos Gpos)
	{
		_Gpos = Gpos;
		for (int y = 0; y < _tileMap.size(); y++)
		{
			for (int x = 0; x < _tileMap[y].size(); x++)
			{
				//This line takes into account offsets, so it can keep a sprite
				// from falling into it's constituent tiles.
				_tileMap[y][x].setNewGlobalPos(Pos(Gpos.m_x + Pos::tilesToPixels(x), Gpos.m_y + Pos::tilesToPixels(y)));
			}
		}
	}

	std::vector<std::vector<Tile>> getTileMap()
	{
		return _tileMap;
	}
	/*
	input: none
	output: output (map<Pos,vector<string>)
	depends on: Tile::getGlobalPos(), Tile::prepTile(), map::at(), vector::size()
	Returns a bunch of prepared Tiles. FOR DEBUGGING PURPOSES ONLY
	*/
	std::map<Pos, std::vector<std::string>> prepSprite()
	{
		std::map<Pos, std::vector<std::string>> output;
		for (int y = 0; y < _tileMap.size(); y++)
		{
			for (int x = 0; x < _tileMap[y].size(); x++)
			{
				output[_tileMap[y][x].getGlobalPos()] = _tileMap[y][x].prepTile();
			}
		}
		return output;
	}
	/*
	input: graphic (map<Pos,vector<string>>)
	output: bool
	depends on: auto, map::first, Pos, vector::push_back, map::at, iostream
	This function actually draws a Sprite. FOR DEBUGGING PURPOSES ONLY
	*/
	void drawSprite(std::map<Pos, std::vector<std::string>> graphic)
	{
		/*
		--SECTION 0--
		This goes through the given graphic, and finds each unique position, to generate
		a 2D vector, representing each unique position the Sprite covers. This then feeds
		into SECTION 1, which will then use that data to go row by row.
		*/
		std::vector<std::vector<Pos>> rowGroupings;
		std::vector<Pos> row;
		int currentRowNum = 0;
		//bool changeRowNum = false;
		for (auto STile : graphic)
		{



			if (STile.first.m_y == currentRowNum)
			{

				row.push_back(STile.first);
			}
			else
			{

				rowGroupings.push_back(row);
				row = {};
				currentRowNum = STile.first.m_y;
				row.push_back(STile.first);

			}
		}
		if (!row.empty())
		{
			rowGroupings.push_back(row);
		}
		/*
		--SECTION 1--
		This takes the data generated in SECTION 0, and uses that to hopefully correctly draw a sprite
		*/
		std::string output;
		for (int y = 0; y < rowGroupings.size(); y++)
		{

			for (int i = 0; i < 8; i++)
			{
				output = "";
				for (int x = 0; x < rowGroupings[y].size(); x++)
				{
					output += graphic.at(rowGroupings[y][x])[i];
				}
				std::cout << output << '\n';

			}
		}
	}
	Pos getGlobalPos()
	{
		return _Gpos;
	}

protected:
	std::vector<std::vector<Tile>> _tileMap;
	Pos _Gpos;
};
/*
The screen class has the following responisibilities:
-Viewpoert management (setNewScrollOffset())
-Rendering (compositeSprite(),prepRow(),drawScreen(),resetCompositing())
Some may argue that this should be two classes. This should be exactly one, due to
how intrerconnected these duties are.
*/
class Screen
{
public:
	/*
	The TileRef Global Static Tile Registry. Useful for finding Standard Tiles by their Global Position.
	Give it a Pos, and if a standard tile exists at that location, it returns a std::unique_ptr<Tile> to that Tile.
	An explanation of the difference between a Standard Tile and a Sprite Tile can be found between Tile::Tile() and Tile::setPixel().
	See the comments between Tile::Tile() and Tile::setPixel() for instructions on how to initialise a Standard Tile and a Sprite Tile.
	*/
	static std::map<Pos, std::unique_ptr<Tile>> TileRef;
	//remeber: originl res: 32W, 28H
	static const int tilesW = 50;
	static const int tilesH = 30;
	static const int tileSize = 8;

	Screen()
	{
		std::vector<Tile> row = {};
		for (int y = 0; y < tilesH; y++)
		{
			row = {};
			for (int x = 0; x < tilesW; x++)
			{
				//row.push_back(Tile(Pos(x*tileSize, y*tileSize),false,false);
				Tile T = Tile(Pos(x * tileSize, y * tileSize), false, false);
				Screen::TileRef[Pos(x * tileSize, y * tileSize)] = std::make_unique<Tile>(T);
				row.push_back(T);


			}
			_tiles.push_back(row);
		}
		_PX = 0;
		_PY = 0;
		_TX = 0;
		_TY = 0;
		_allowScrolling = false;
	}

	void setTile(Pos tilePos, Tile newTile)
	{
		int x;
		int y;
		if (!_allowScrolling)
		{
			x = tilePos.m_x % tilesW;
			y = tilePos.m_y % tilesH;
		}
		else {
			y = tilePos.m_y % _tiles.size();
			x = tilePos.m_x % _tiles[y].size();
		}
		_tiles[y][x] = newTile;
		TileRef[Pos(x * 8, y * 8)] = std::make_unique<Tile>(newTile);
	}

	Tile& getTile(Pos posInTiles)
	{
		int x;
		int y;
		if (!_allowScrolling)
		{
			x = (posInTiles.m_x % tilesW);
			y = (posInTiles.m_y % tilesH);
		}
		else {
			y = (posInTiles.m_y % _tiles.size());
			x = (posInTiles.m_x % _tiles[y].size());
		}
		return _tiles[y][x];
	}
	/*
	How to calculate pixelOffset and tileOffset:
	You have a Pos(X,Y)
	TileOffset = Pos(X - (X % 8), Y - (Y % 8));
	PixelOffset = Pos((X % 8),(Y % 8))
	*/
	void setNewScrollOffset(Pos pixelOffset, Pos tileOffset)
	{
		int PX = pixelOffset.m_x;
		int PY = pixelOffset.m_y;
		int TX = tileOffset.m_x;
		int TY = tileOffset.m_y;
		//PX and PY must stay in the bounds of a tile
		_PX += PX;
		_PY += PY;
		_TX += floor(PX / 8);
		_TY += floor(PY / 8);
		_PX = ((PX % 8) + 8) % 8;
		_PY = ((PY % 8) + 8) % 8;
		_allowScrolling = true;
	}
	void stopCamera()
	{
		_allowScrolling = false;
	}
	/*
	APPLYDIFF: Applies a difference, used to render stuff after the first frame.
	USE INSTEAD OF DRAWSCREEN!
	Note: Please, Do not use offsets outside of -1 to 1. This function ignores magnitude.

	*/
	bool applyDiff(Pos newScrollOffset)
	{
		if (!_allowScrolling)
		{
			return true;
		}
		Pos currentScrollOffset = Pos(_TX, _TY);
		Pos newScrollOffsetTiles = Pos(newScrollOffset.m_x - (newScrollOffset.m_x % 8), newScrollOffset.m_y - (newScrollOffset.m_y % 8));
		Distances diff = currentScrollOffset - newScrollOffsetTiles;
		if (diff.Xdiff == 0 && diff.Ydiff == 0)
		{
			return true;
		}
		int leading = 0;
		int trailing = 0;
		bool vertical = false;
		if (diff.Xdiff > 0)
		{ // right
			leading = (tilesH * tileSize) - 1;
			trailing = 0;
			vertical = false;
		}
		if (diff.Xdiff < 0)
		{// left
			leading = 0;
			trailing = (tilesH * tileSize) - 1;
			vertical = false;
		}
		if (diff.Ydiff > 0)
		{// up
			leading = (tilesW * tileSize) - 1;
			trailing = 0;
			vertical = true;
		}
		if (diff.Ydiff < 0)
		{ // down
			leading = 0;
			trailing = (tilesW * tileSize) - 1;
			vertical = true;
		}
		if(vertical)
		{
			for (int y = 0; y < tilesW * tileSize; y++)
			{
				 Tile& currentTile =_tiles[y][leading - (leading % 8)];
				 Pixel currentPixel = currentTile.getPixel(Pos(y,leading % 8));
				 std::cout << "\x1b[" << leading + 1 << ";" << y + 1 << "H" << currentPixel.prepSelf();
				 currentTile = _tiles[y][trailing - (trailing % 8)];
				 currentPixel = currentTile.getPixel(Pos(y, trailing % 8));
				 std::cout << "\x1b[" << trailing + 1 << ";" << y + 1 << "H\x1b[K";
			}
		}
		else 
		{
			for (int x = 0; x < tilesH * tileSize; x++)
			{
				Tile& currentTile =_tiles[leading - (leading % 8)][Pos::tilesToPixels(x)];
				Pixel currentPixel = currentTile.getPixel(Pos(leading % 8,x));
				std::cout << "\x1b[" << x+ 1 << ";" << leading + 1 << "H" << currentPixel.prepSelf();
				currentTile = *TileRef.at(Pos(trailing - (trailing % 8),Pos::tilesToPixels(x)));
				currentPixel = currentTile.getPixel(Pos(trailing % 8, x));
				std::cout << "\x1b[" << x + 1 << ";" << trailing + 1 << "H\x1b[K";
			}
		}
		
		return false;
	}
	
	/*
	This prepares one row of Pixels to be drawn.
	*/
	std::string::iterator prepRow(int TrowG, int TrowL, std::string::iterator bufferIt)
	{
		//	std::string output = "";
		int Scy = (TrowG * 8) + TrowL - _PY;
		for (int i = 0; i < tilesW; i++)
		{
			int TileXind = (i + _TX) % tilesW;
			int TileYind = (TrowG + _TY) % tilesH;
			Tile& currentTile = _tiles[TileYind][TileXind];
			for (int j = 0; j < 8; j++)
			{
				int Scx = (i * 8) + j - _PX;
				Pixel currentPixel = currentTile.getPixel(Pos(j, TrowL));
				if (Scx >= 0 && Scx < (tilesW * tileSize) && Scy >= 0 && Scy < (tilesH * tileSize))
				{
					bufferIt = currentPixel.FprepSelf(bufferIt, Pos(Scx, Scy));
				}
			}
		}
		//	output += '\n';
		return bufferIt;
	}
	/*
	This takes the given sprite, and uses it's global position to correctly
	composite it, so that it can be viewed.
	*/
	void compositeSprite(Sprite& sprite)
	{
		const std::vector<std::vector<Tile>>& STileMap = sprite.getTileMap();
		float PNG = 1.0;
		for (int y = 0; y < STileMap.size(); y++)
		{
			for (int x = 0; x < STileMap[y].size(); x++)
			{
				Tile currentSpriteTile = STileMap[y][x];
				Pos currentGPos = currentSpriteTile.getGlobalPos();
				Pos scPos = Pos(currentGPos.m_x / tileSize, currentGPos.m_y / tileSize);
				Tile& currentBGTile = getTile(scPos);
				_compositedTiles.push_back(currentBGTile);
				for (int PY = 0; PY < 8; ++PY)
				{
					for (int PX = 0; PX < 8; ++PX)
					{
						Pos currentPos = Pos(PX, PY);
						Pixel currentSpritePixel = currentSpriteTile.getPixel(currentPos);
						if (currentSpritePixel._isTransparent)
						{
							PNG = 0.0;
						}
						else
						{
							PNG = 1.0;
						}
						color compositedColor = currentSpriteTile.getPixel(currentPos).trueAlpha(currentBGTile.getPixel(currentPos), PNG);
						Pixel compositedPixel = Pixel(compositedColor.Red, compositedColor.Green, compositedColor.Blue, Pos(0, 0));
						currentBGTile.setPixel(currentPos, compositedPixel);
					}
				}
				//setTile(currentBGTile.getGlobalPos(),currentBGTile);// actually applies the compositing
			}
		}
	}
	/*
	This resets the compositing process of compositeSprite.
	RECCOMENDED ORDER OF OPERATIONS:
	0) Game logic <- you can customise this.
	(Please use setNewScrollOffset before your game logic exits if you need to)
	1) compositeSprite()
	2) drawScreen()
	3) resetCompositing()
	*/
	void resetCompositing()
	{
		for (int i = 0; i < _compositedTiles.size(); i++)
		{
			//Screen::TileRef[_compositedTiles[i].getGlobalPos()] = std::make_unique<Tile>(_compositedTiles[i]);
			Tile compositedTile = _compositedTiles[i];
			Tile* liveTilePtr = Screen::TileRef.at(_compositedTiles[i].getGlobalPos()).get();
			*liveTilePtr = compositedTile;
			setTile(_compositedTiles[i].getGlobalPos(), compositedTile);

		}
		_compositedTiles = {};
	}
	/*
	/!\ This is where a lot of the memory gets eaten up in screen, and why I reccomended only one instance of Screen/!\
	At the moment, This is slowly losing relevance. 
	if The current situation isn't:
	- A cutscene
	- The credits (call clearScreen first) 
	- The first frame 
	- a turn-based battle (or similar)
	Then consider if applyDiff is more suited for your needs. It's faster.	
	*/
	//[[deprecated("Screen::drawScreen is becoming deprecated! Call ApplyDiff instead!")]]
	void drawScreen()
	{
		/*
		At the time of typing, (Nov 2025) this is the most information I think I've ever stored in a single variable.
		Let's do a little math. _tiles is bound to hold ~1.15MB+. That is the number to beat.
		1 pixel holds 12 Bytes of state information.
		A tile is 64 pixels, makng 768 bytes per tile.
		50* 30 = 1500 (screen resolution)
		768 bytes per tile * 1500 Tiles = 1152000 Bytes (~1.15MB)
		However, this calculation is different when we want to PRINT stuff
		up in Pixel::prepSelf(), you will find an ANSI format string, measuring in (Maximum, after formatting) at 29 characters. or 24 Bytes.
		29 Bytes * 64 =1586  Bytes ( formerly 2368 )
		1586 bytes per tile * 1500 tiles = 2379000 bytes (2.38 MB)(formerly 3552000 bytes, (3.55MB))
		3.55MB > 1.15MB thus, this variable holds the record for the most information stored in a single variable, hence the name ohLawdHeComin
		*/

		const size_t totalPixels = static_cast<size_t>(tilesW * tileSize) * (tilesH * tileSize);
		const size_t charPerPixel = 40; // the 29 characters of the original string being concatenated 96000 times, plus headroom
		const size_t totalSize = totalPixels * charPerPixel;
		std::string ohLawdHeComin = "";
		ohLawdHeComin.resize(totalSize);
		std::string::iterator currentIt = ohLawdHeComin.begin();
		for (int i = 0; i < tilesH; i++)
		{
			for (int j = 0; j < tileSize; j++)
			{
				currentIt = prepRow(i, j, currentIt);
			}
		}
		ohLawdHeComin.resize(std::distance(ohLawdHeComin.begin(), currentIt));

		fwrite(ohLawdHeComin.c_str(), 1, ohLawdHeComin.length(), stdout);
		fflush(stdout);
	}

private:
	std::vector<std::vector<Tile>> _tiles;
	std::vector<Tile> _compositedTiles;
	int _PX;
	int _PY;
	int _TX;
	int _TY;
	bool _allowScrolling;

};
std::map<Pos, std::unique_ptr<Tile>> Screen::TileRef = {};

// this gives a sprite with ANIMATION!
class IndexedSprite : public Sprite
{
public:
	IndexedSprite() :Sprite()
	{
		_currentFrame = {};
	}
	std::vector<Pos> getCurrentFrame()
	{
		return _currentFrame;
	}

	void setCurrentFrame(std::vector<Pos> newFrame)
	{
		_currentFrame = newFrame;
	}

	void  addTile(Tile& tile, int rowIndex) override
	{
		if (rowIndex >= _allFrames.size())
		{
			_allFrames.resize(rowIndex + 1);
		}
		if (tile.getIsSprite())
		{
			_allFrames[rowIndex].push_back(tile);
		}
		else {
			std::cout << "Error: IndexedSprite should only have Tiles initialised as Sprite Tiles!" << std::endl;
			return;
		}
	}

	void editTile(int indX, int indY, Pos pos, Pixel newData) override
	{
		if (indY >= 0 && indY < _allFrames.size())
		{
			if (indX >= 0 && indX < _allFrames[indY].size())
			{
				_allFrames[indY][indX].setPixel(pos, newData);
			}
		}
	}

	void replaceTile(int indX, int indY, Tile newTile) override
	{
		if (indY >= 0 && indY < _allFrames.size())
		{
			if (indX >= 0 && indX < _allFrames[indY].size())
			{
				_allFrames[indY][indX] = newTile;
			}
		}
		else
		{
			std::cout << "IndexedSprite::replaceTile() recieved invalid indexes" << std::to_string(indX) << std::to_string(indY) << std::endl;
			return;
		}
	}

	Tile& getTile(int indX, int indY) override
	{
		static Tile defaultReturn = Tile(Pos(-1, -1), true, false);
		if (indY >= 0 && indY < _allFrames.size())
		{
			if (indX >= 0 && indX < _allFrames[indY].size())
			{
				return _allFrames[indY][indX];
			}
		}
		else
		{
			std::cout << "IndexedSprite::getTile() recieved invalid indexes" << std::to_string(indX) << std::to_string(indY) << std::endl;
			return defaultReturn;
		}
	}
	// this allows you to change frames
	void setupFrame()
	{
		for (int i = 0; i < _currentFrame.size(); i++)
		{
			if (_currentFrame[i].m_y >= _allFrames.size() || _currentFrame[i].m_x >= _allFrames[_currentFrame[i].m_y].size())
			{
				std::cout << "IndexedSprite::setupFrame() experienced an error" << std::endl;
				return;
			}
			Sprite::replaceTile(
				_currentFrame[i].m_x,
				_currentFrame[i].m_y,
				_allFrames[_currentFrame[i].m_y][_currentFrame[i].m_x]
			);
		}

	}

protected:
	/*
	_currentFrame
	Contains a collection of Pos Objects.These Pos objects are used as 2D indices into
	the _tileMap inherited from Sprite. This is so that the current values in the
	_currentFrame represent the CURRENT index of an IndexedSprite. Keep in mind that,
	in indexedSprite, a Pos object is in TILES. Should you need to convert to pixels, call Pixel::tilesToPixels();
	*/
	std::vector<Pos> _currentFrame;
	std::vector<std::vector<Tile>> _allFrames;
};

//finally, an entity.
class Entity : public IndexedSprite
{
public:

	Entity(int HP)
	{
		_hitPoints = HP;
	}

	void setHP(int newHP)
	{
		if (newHP >= 0)
		{
			_hitPoints = newHP;
		}
	}
	int getHP()
	{
		return _hitPoints;
	}

	void setCollision(bool newState)
	{
		_hasCollision = newState;
	}
	/*
	The more advanced, but slow way to check collision, Best used for interactions between Entity objects.
	because this method does not rely on the Tile Registry.
	*/
	bool collisionCheck(Tile other)
	{
		Pos tilePos = other.getGlobalPos();
		std::vector<Distances> tileDists; // contains a list of all the Distances stuct instances 
		for (int y = 0; y < _tileMap.size(); y++)
		{
			for (int x = 0; x < _tileMap[y].size(); x++)
			{
				tileDists.push_back(tilePos - _tileMap[y][x].getGlobalPos()); // calculates a Distances struct
			}
		}
		std::vector<double> euclids;
		for (int i = 0; i < tileDists.size(); i++)//extracts the euclidean distance
		{
			euclids.push_back(tileDists[i].EuclideanDistance);
		}
		/*
		This check will extract the shortest Euclidean distance from the list of euclidean distances calculated earlier.
		Should there be a distance of less than 1, that signals a collision.
		Because Pos objects are an integer coordinates, and Pixels inherit from Pos, this calculates distances in Pixels.
		Thus, a Euclidean distance of less than 1 indicates that the two objects are less than 1 pixel apart, and are thus colliding
		*/
		if (!euclids.empty() && *min_element(euclids.begin(), euclids.end()) < 1)
		{
			return true;
		}
		return false;
	}

	void addAnimation(std::vector<std::vector<Pos>>& AF)
	{
		_animFrames.push_back(AF);
	}

	void editAnimation(int index, std::vector<std::vector<Pos>> stuff)
	{
		if (index > -1 && index < _animFrames.size())
		{
			_animFrames[index] = stuff;
		}
	}

	void setCurrentAnimIndex(int newInd)
	{
		_currentAnimIndex = newInd;
	}

	void advanceOneFrame()
	{


		_frame = ((++_frame) % _animFrames[_currentAnimIndex].size()); //+ startOffset;
	}

	void applyFrame()
	{
		_currentFrame = _animFrames[_currentAnimIndex][_frame];
	}
	/*
	A simper, faster method of checking collision.
	inputs: gravVector (Pos), tileIndex(std::map<Pos,Tile>)
	outputs: Pos.
	depends on: std::map
	*/
	Pos calculatePhysics(Pos gravVector, std::map<Pos, std::unique_ptr<Tile>> tileIndex)
	{
		Pos newGPos = _Gpos + gravVector;
		if (tileIndex.count(newGPos) != 0)
		{
			if (tileIndex.at(newGPos)->_collidable)
			{
				return _Gpos;
			}
		}
		return newGPos;
	}
private:

	int _hitPoints;
	bool _hasCollision = true;
	std::vector<std::vector<std::vector<Pos>>> _animFrames;
	int _currentAnimIndex;
	int _frame;


};
