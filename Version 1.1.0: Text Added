};

class Pixel: public Pos
{
public:
	/* Pixel
	inputs: index (int), alpha (int), scrPos(Pos)
	outputs: none depends on: Pos (Class) Creates a colour on a screen.
	 alpha provides a less taxing transparency. If you want proper transparency, call the TrueAlpha function
	 BG == background
	 characters have a foreground (the character itself) and a BackGround (abbreviated to BG), showing up behind.
	*/
	Pixel(int red,int blue,int green, int alpha, Pos scrpos):Pos(scrpos.m_x,scrpos.m_y)
	{
		// the mathematecally correct way to translate 5 bit to 8 bit colour
		m_red = int((red % 32) * (255.0/31.0));
		m_blue = int((blue % 32) * (255.0/31.0));
		m_green = int((green % 32) * (255.0/31.0));
		_alpha = alpha % (alphaRef.size());
		_hasBackGround = false;

	}
	/* returns a Pixel, ready to print. */
	std::string prepSelf()
	{
		std::string output;
		if(!_hasBackGround)
		{
			// output=format("\x1b[0;38;5;{};49m{}\x1b[0;39;49m",_index,alphaRef[_alpha]);
			output +="\x1b[0;38;2;";
			output +=std::to_string(m_red);
			output +=";";
			output +=std::to_string(m_green);
			output +=";";
			output +=std::to_string(m_blue);
			output +=";49m";
			output +=alphaRef[_alpha];
			output += "\x1b[0m";
		} else
		{
			//output=format("\x1b[0;38;5;{};48;5;{}m{}\x1b[0;39;49m",_index,_BGind,alphaRef[_alpha]);
			output = format("\x1b[0;38;2;{};{};{};48;2;{};{};{}m{}\x1b[0m",m_red, m_green, m_blue, m_BackGroundRed.value_or(0), m_BackGroundGreen.value_or(0), m_BackGroundBlue.value_or(0), alphaRef[_alpha]);
		}
		return output;

	}
	int getRed()
	{
		return m_red;

	}
	int getGreen()
	{
		return m_green;
	}
	int getBlue()
	{
		return m_blue;
	}
	int getBGR()
	{
		if(_hasBackGround)
		{
			return m_BackGroundRed.value_or(0);

		}
		else
		{
			return -1;

		}

	}
	int getBGG()
	{
		if(_hasBackGround)
		{
			return m_BackGroundGreen.value_or(0);

		}
		else
		{
			return -1;

		}

	}
	int getBGB()
	{
		if(_hasBackGround)
		{
			return m_BackGroundBlue.value_or(0);

		}
		else
		{
			return -1;

		}

	}
	void setBG(int BGRed, int BGGreen, int BGBlue)
	{
		m_BackGroundRed = (BGRed % 32) * (255.0/31.0);
		m_BackGroundBlue = (BGBlue % 32) * (255.0/31.0);
		m_BackGroundGreen = (BGGreen % 32) * (255.0/31.0);
		_hasBackGround = true;

	}
	// inputs: other (Pixel), alpha (float)
	// outputs: index (int)
	// depends on: none
	//Performs proper alpha blending.
	// the functiuon is based on this formula:
	// result = (tranparency * foreground) + (1 - transparency) * background
	//0.0 color A| -----------------------------------| 1.0 colour B
	color trueAlpha(Pixel other, float alpha)
	{
		if(alpha < 0.0 || alpha > 1.0)
		{	//error
			alpha = 0.5;
		}
		// background
		float foregroundAR;
		float foregroundAG;
		float foregroundAB;
		float backgroundAR;
		float backgroundAG;
		float backgroundAB;
		if(other.getBGB() != -1)
		{
			foregroundAR = alpha *m_BackGroundRed.value_or(0);
			foregroundAG = alpha *m_BackGroundGreen.value_or(0);
			foregroundAB = alpha *m_BackGroundBlue.value_or(0);
			backgroundAR = (1-alpha) * other.getBGR();
			backgroundAG = (1-alpha) * other.getBGG();
			backgroundAB = (1-alpha) * other.getBGB();
		} else {
			//fallbacks
			foregroundAR = 0.0;
			foregroundAG = 0.0;
			foregroundAB = 0.0;
			backgroundAR = 0.0;
			backgroundAG = 0.0;
			backgroundAB = 0.0;
		}
		float finalAR = foregroundAR+backgroundAR;
		float finalAG = foregroundAG+backgroundAG;
		float finalAB = foregroundAB+backgroundAB;
		// foregroud
		float foregroundBR = alpha *m_red;
		float foregroundBG = alpha *m_green;
		float foregroundBB = alpha *m_blue;
		float backgroundBR = (1-alpha) * other.getRed();
		float backgroundBG = (1-alpha) * other.getGreen();
		float backgroundBB = (1-alpha) * other.getBlue();
		float finalBR = foregroundBR + backgroundBR;
		float finalBG = foregroundBG + backgroundBG;
		float finalBB = foregroundBB + backgroundBB;
		color result;
		result.transparency = alpha;
		result.FRed = finalBR;
		result.FGreen = finalBG;
		result.FBlue = finalBB;
		result.BRed = finalAR;
		result.BGreen = finalAG;
		result.BBlue = finalAB;
		return result;

	}
	void setNewAlpha(int alpha)
	{
		_alpha = alpha;
	}
	int getAlphaIndex()
	{
		return _alpha;
	}
	std::string getAlphaValue()
	{
		return alphaRef[_alpha];
	}
	void setNewRGB(int red, int green, int blue)
	{
		m_red = int((red % 32) * (255.0/31.0));
		m_blue = int((blue % 32) * (255.0/31.0));
		m_green = int((green % 32) * (255.0/31.0));
	}
	bool hasBG()
	{
		return _hasBackGround;
	}

private:
	int m_red;
	int m_blue;
	int m_green;
	int _alpha;
	std::optional<int> m_BackGroundRed;
	std::optional<int> m_BackGroundGreen;
	std::optional<int> m_BackGroundBlue;
	bool _hasBackGround;

	static const std::vector<std::string> alphaRef;
};
